+void Explore::publishPlanningCycle(const rclcpp::Time& ros_start,
+                                   double wall_start,
+                                   const rclcpp::Time& ros_end,
+                                   double wall_end, size_t n_frontiers,
+                                   const geometry_msgs::msg::Point& goal)
+{
+  exploration_msgs::msg::PlanningCycle msg;
+  msg.cycle_id = planning_cycle_id_++;
+  msg.stamp_start = ros_start;
+  msg.stamp_end = ros_end;
+  msg.wall_start = wall_start;
+  msg.wall_end = wall_end;
+  msg.n_frontiers = static_cast<uint32_t>(n_frontiers);
+  msg.goal = goal;
+  planning_cycle_pub_->publish(msg);
+}
