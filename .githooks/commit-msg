#!/usr/bin/env bash
# commit-msg hook: strip AI-tool attribution lines from every commit message.
#
# Removes, case-insensitively:
#   - Co-Authored-By trailers naming Claude / Anthropic / an AI assistant
#   - "Generated with ... Claude ..." footers (with or without the robot emoji)
#   - Claude-Session: / similar session trailers
# Then fails the commit if anything matching is still present.
#
# Enabled per clone by scripts/setup_git_hooks.sh (sets core.hooksPath=.githooks).
# The flag is on by default. Turning it off needs an explicit
#   git config explorebench.stripAttribution false
set -euo pipefail

msg_file="$1"

if [[ "$(git config --get explorebench.stripAttribution || echo true)" == "false" ]]; then
  exit 0
fi

PATTERN='(co-authored-by:.*(claude|anthropic|noreply@anthropic\.com|\bai\b|assistant|copilot|chatgpt|openai))|(generated (with|by).*(claude|anthropic))|(^\s*🤖)|(^\s*claude-[a-z-]*:)'

tmp="$(mktemp)"
grep -viE "$PATTERN" "$msg_file" > "$tmp" || true
# Collapse blank-line runs left behind by removed trailers.
cat -s "$tmp" > "$msg_file"
rm -f "$tmp"

if grep -qiE "$PATTERN" "$msg_file"; then
  echo "commit-msg: AI attribution still present in commit message; aborting." >&2
  exit 1
fi
